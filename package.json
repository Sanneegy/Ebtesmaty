{
  "name": "ebtesmaty",
  "version": "1.0.0",
  "private": true,
  "description": "Ebtesamty Dental Clinic Management System — Multi-Branch Clinical & Administrative Platform",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:init": "node scripts/db-init.js",
    "db:start": "node scripts/db-start.js",
    "db:stop": "node scripts/db-stop.js",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "node scripts/seed-runner.js",
    "db:studio": "prisma studio",
    "test": "node scripts/test-isolated.cjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:isolated": "node scripts/test-isolated.cjs",
    "demo:prepare": "node scripts/presentation.cjs prepare",
    "demo:start": "node scripts/presentation.cjs start",
    "actual:start": "node scripts/presentation.cjs actual",
    "data:audit": "node scripts/audit-data.cjs",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "node scripts/seed-runner.js"
  },
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "lucide-react": "^0.475.0",
    "next": "^15.5.29",
    "pg": "^8.13.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.50.1",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.29",
    "postcss": "^8.5.23",
    "prisma": "^6.4.1",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^5.1.1"
  },
  "overrides": {
    "tinypool": ">=2.1.2",
    "deepmerge-ts": ">=8.0.0",
    "effect": ">=3.22.1",
    "postcss": "$postcss"
  }
}
