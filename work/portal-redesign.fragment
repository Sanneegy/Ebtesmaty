  const c=(en:string,ar:string)=>isAr?ar:en;
  const amount=(p:number)=>new Intl.NumberFormat(isAr?'ar-EG':'en-EG',{style:'currency',currency:'EGP',maximumFractionDigits:2}).format(p/100);
  const first=(patient?.fullName||user.fullName).split(' ')[0];
  const other=careTimeline.filter(a=>a.id!==nextAppointment?.id);
  const [booking,setBooking]=useState(false);
  const intakeNeeded=!latestSubmission||latestSubmission.status==='DRAFT';
  const offered=initialRequests.some(r=>r.status==='ALTERNATIVE_PROPOSED');
  const panel="rounded-3xl border border-[#d5e3db] bg-white p-5 sm:p-7";
  return <main className="max-w-6xl mx-auto w-full px-4 sm:px-7 py-6 space-y-5">
  <header className="flex flex-wrap items-center justify-between gap-4"><div><small>{patient?.patientNumber}</small><h1 className="text-3xl font-bold">{c('Welcome back,','مرحباً بعودتك،')} {isAr&&first==='Passant'?'بسنت':first}!</h1><p>{c('Everything you need for your next dental visit.','كل ما تحتاجه لزيارتك القادمة.')}</p></div>{patient&&<button className="primary-button" onClick={()=>setBooking(true)}><PlusCircle size={17}/>{c('Book New Appointment','احجز موعداً جديداً')}</button>}</header>
  {actionSuccess&&<p role="status" className="rounded-xl p-3 bg-emerald-50">{actionSuccess}</p>}
  <div className="grid lg:grid-cols-[1.25fr_1fr] gap-5"><section className="rounded-3xl bg-[#163447] p-6 text-white"><h2 className="text-white text-xl font-bold">{c('My Next Appointment','موعدي القادم')}</h2>{nextAppointment?<><div className="mt-4"><StatusBadge status={nextAppointment.status}/></div><p className="text-3xl font-bold mt-3">{localDate(nextAppointment.appointmentDate,locale)}</p><p className="mt-1"><bdi>{nextAppointment.startTime} – {nextAppointment.endTime}</bdi> · {nextAppointment.durationMinutes} {c('minutes','دقيقة')}</p><p className="mt-3">{nextAppointment.dentistUser?.fullName} · <TranslatedText text={nextAppointment.branch?.name||''}/></p><p><TranslatedText text={nextAppointment.serviceDescription}/></p><details className="mt-4 border-t border-white/30 pt-3"><summary className="font-bold cursor-pointer">{c('View Appointment Details','عرض تفاصيل الموعد')}</summary><p className="my-3">{c('Check in at reception when you arrive. Changes are subject to clinic policy.','عند الوصول توجّه إلى الاستقبال. تخضع التغييرات لسياسة العيادة.')}</p><div className="flex flex-wrap gap-3"><button className="secondary-button" onClick={()=>setShowRescheduleModal(true)}>{c('Request rescheduling','طلب تغيير الموعد')}</button><button className="secondary-button" onClick={()=>setShowCancelModal(true)}>{c('Cancel appointment','إلغاء الموعد')}</button></div></details></>:<p className="py-4">{c('No confirmed appointment yet.','لا يوجد موعد مؤكد بعد.')}</p>}{other.map(a=><p className="border-t border-white/30 pt-2 mt-2" key={a.id}>{localDate(a.appointmentDate,locale)} · {a.startTime} · {a.dentistUser?.fullName}</p>)}</section>
  <section className={panel}><h2 className="text-xl font-bold">{c('Things You Need to Do','مهامك القادمة')}</h2>{intakeNeeded&&<Link className="block border-b py-4 font-semibold" href="/portal/intake">{c('Complete your medical intake','أكمل الاستبيان الطبي')} ←</Link>}{offered&&<Link className="block border-b py-4" href="/portal/appointments">{c('Review a proposed appointment time','راجع الموعد البديل المقترح')}</Link>}{billingSummary.totalBalanceDue>0&&<Link className="block py-4" href="/portal/billing">{c('View invoice','عرض الفاتورة')} · <b>{amount(billingSummary.totalBalanceDue)}</b></Link>}{!intakeNeeded&&!offered&&!billingSummary.totalBalanceDue&&<p className="py-4">{c("You're all caught up!","لا توجد مهام معلقة.")}</p>}</section></div>
  <section className="rounded-3xl bg-[#E3F0EB] p-6"><h2 className="text-xl font-bold">{c('My Treatment Journey','رحلة علاجي')}</h2>{treatmentPlans.length?treatmentPlans.map(p=><div key={p.id} className="mt-4"><h3 className="font-semibold">{p.title}</h3><ol className="flex flex-wrap gap-4 mt-3">{p.items.map((it:any)=><li key={it.id} className="border-s-4 border-[#176C5B] ps-4"><b><TranslatedText text={it.procedureName}/></b><div><StatusBadge status={it.status}/>{it.performedAt&&' · '+localDate(it.performedAt,locale)}</div></li>)}</ol></div>):<p>{c('No shared treatment plan yet.','لا توجد خطة علاج مشتركة بعد.')}</p>}</section>
  <section className={panel}><h2 className="text-xl font-bold">{c('My Financial Summary','ملخص حسابي')}</h2><dl className="grid grid-cols-2 sm:grid-cols-3 gap-4 my-4">{[[c('Total invoiced','إجمالي الفواتير'),billingSummary.totalInvoiced],[c('Total paid','إجمالي المدفوع'),billingSummary.totalPaid],[c('Amount due','المبلغ المستحق'),billingSummary.totalBalanceDue]].map(([k,v])=><div key={k}><dt>{k}</dt><dd className="text-xl font-bold tabular-nums">{amount(Number(v))}</dd></div>)}</dl>{estimatedTreatmentCostPiasters>0&&<p>{c('Future care estimate · not due now','تقدير العلاج المستقبلي · غير مستحق الآن')}: {amount(estimatedTreatmentCostPiasters)}</p>}{installments[0]&&<p>{c('Next installment','القسط التالي')}: {localDate(installments[0].dueDate,locale)} · {amount(installments[0].amountPiasters)}</p>}<Link className="inline-block mt-4 font-bold underline" href="/portal/billing">{c('View Payments & Invoices','عرض المدفوعات والفواتير')}</Link></section>
  <Link className="flex items-center gap-4 p-5 border-y font-bold" href="/portal/records"><FileText/>{c('My Records & Care','سجلاتي ورعايتي')} <ChevronRight size={17}/></Link>
  {booking&&patient&&<PatientBooking patientId={patient.id} onClose={()=>setBooking(false)} onSaved={()=>{setBooking(false);setActionSuccess(c('Request sent to reception.','تم إرسال الطلب إلى الاستقبال.'));router.refresh()}}/>}
