# Environment Variables Template for Ebtesamty Dental Clinic Management System
# Copy this file to .env and supply actual deployment values. Never commit actual secrets.

# PostgreSQL Relational Database URL
DATABASE_URL="postgresql://ebtesamty:YOUR_SECURE_PASSWORD@localhost:5432/ebtesamty?schema=public"

# Session Encryption Secret (at least 32 characters for production)
SESSION_SECRET="replace-with-a-cryptographically-secure-random-string-in-production"

# Environment Mode: development | test | production
NODE_ENV="development"

# Clinic Application URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Mail service configuration (development uses local mail sink)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="noreply@ebtesamty.com"
